# LLM provider for the AI summary. Leave GEMINI_API_KEY empty to use the template fallback ("Shablon").
# Get a key in Google AI Studio. For real patient data use a PAID Gemini API tier (see README, "AI summary and privacy").
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_S=25
# Telegram: next round
TELEGRAM_BOT_TOKEN=
# Secrets: generate your own, never commit them
JWT_SECRET=
# generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
DATABASE_URL=sqlite:///./onaradar.db
DEMO_MODE=true
SLA_RED_MINUTES=120
SLA_YELLOW_HOURS=72
