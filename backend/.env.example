# LLM provider for the AI summary. Leave GEMINI_API_KEY empty to use the template fallback ("Shablon").
# Get a key in Google AI Studio. For real patient data use a PAID Gemini API tier (see README, "AI summary and privacy").
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Chosen by the task-06 benchmark (3/3 ok, ~2.7 s). Fallback is tried on 503/504/429/timeout.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Total time budget for all attempts of one summary (primary -> fallback -> plain retry)
LLM_TIMEOUT_S=25
# Cap per attempt (Gemini minimum is 10 s): a hung primary model still leaves time for the fallback model
LLM_ATTEMPT_TIMEOUT_S=10
# Pre-generate the DEMO1-DEMO4 AI summaries on backend start (only when a key is present)
LLM_PREWARM=true
# Telegram: next round
TELEGRAM_BOT_TOKEN=
# Secrets: generate your own, never commit them
JWT_SECRET=
# generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
# HMAC-SHA256 secret for the keyed JShShIR (PINFL) lookup hash. Must be its own random value (not JWT_SECRET).
# DEMO_MODE=true falls back to JWT_SECRET if empty; DEMO_MODE=false refuses to start without it.
# Changing it is safe: on startup the backend recomputes every stored hash.
PINFL_HASH_SECRET=
DATABASE_URL=sqlite:///./onaradar.db
DEMO_MODE=true
SLA_RED_MINUTES=120
# DEMO_MODE only: red SLA in minutes (use the "Demo: SLA muddatini hozir tugatish" button to escalate live)
DEMO_SLA_RED_MINUTES=10
SLA_YELLOW_HOURS=72
# Adaptive visit intensity (advisory only; mandatory 12 visits are NEVER reduced)
LIGHT_VISIT_MAX_WEEKS=36
MINUTES_SAVED_PER_LIGHT_VISIT=10
PROPOSE_FEWER_VISITS=false
